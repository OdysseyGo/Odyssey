# Database
DB_HOST=db
DB_PORT=5432
ENV_MODE=development 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=odyssey_db

#IOS Bundle
APP_BUNDLE_ID=com.app.odyssey.bilkent.yourname

# Django
SECRET_KEY=your-secret-key-here
DEBUG=1
ALLOWED_HOSTS=*

# API Keys
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AI Generation Limits
AI_GENERATION_RATE_LIMIT=5/hour
AI_GENERATION_MAX_ACTIVE_JOBS=1

# AWS S3 Storage
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=your-region-e.g.-us-east-1
AWS_S3_REGION_NAME=your-region-e.g.-us-east-1

## Apple stuff
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.yourcompany.odyssey
APNS_USE_SANDBOX=True

# AdMob (mobile ad SDK app IDs; ad unit IDs are managed in DB via AdPlacement)
ADMOB_APP_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
