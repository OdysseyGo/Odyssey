# Database
DB_HOST=db
DB_PORT=5432
INITIAL_SEED=True # Set to True to enable seeding during container startup, False to disable
ENV_MODE=development 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=odyssey_db

#IOS Bundle
APP_BUNDLE_ID=com.app.odyssey.bilkent.yourname

# Django
SECRET_KEY=your-secret-key-here
DEBUG=1
ALLOWED_HOSTS=*

# API Keys
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AWS S3 Storage
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=your-region-e.g.-us-east-1

AI_PROVIDER=azure_openai
AI_FALLBACK_PROVIDER=gemini
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# Azure OpenAI (primary)
# IMPORTANT: deployment value must be your Azure deployment name for GPT-5 nano.
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=your-azure-openai-subscription-key
AZURE_OPENAI_DEPLOYMENT_TOUR_GEN=gpt-5-nano